cabal-version: 1.12

name:           hello-tests
version:        0.0.0.0
build-type:     Simple

library
  exposed-modules:
      Hello
  hs-source-dirs:
      src
  build-depends:
      base
  default-language: Haskell2010

test-suite spec
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:
      test
  build-depends:
      base
    , hello-tests
  default-language: Haskell2010
